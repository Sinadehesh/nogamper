# Copy to .env for development. Every value shown is the default in
# backend/config.py unless it says otherwise; a line you delete falls back to
# that default.
#
# What is not here, on purpose: a house margin, a boost schedule, a prize
# table. Those settings no longer exist in the code, so there is nothing to
# set to zero and nothing to switch back on. Points can be bought (see "The
# shop", below) and there is no setting anywhere that lets value back out.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres 14+ with db/migrations applied (make migrate-py).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
DB_POOL_MIN=2
DB_POOL_MAX=10

# Rate limits and the price cache. If Redis is down the limits fail open and
# prices are read from Postgres, so the site keeps working.
REDIS_URL=redis://localhost:6379/0

# ----- Accounts and sessions ---------------------------------------------

# Signs session tokens. Rotating it signs everybody out. Required always;
# at least 32 characters in production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a sign-in lasts: 30 days. A guest's cookie is the only key to
# their account, so a short session would simply delete guests.
SESSION_TTL_SECONDS=2592000

# Shared secret with the web tier (apps/web's INTERNAL_API_KEY, same value).
# Only a request carrying it may open a session or say which visitor it is
# acting for. Empty in development; at least 32 characters in production,
# where the API refuses to start without it.
INTERNAL_API_KEY=

# Origins allowed to call the API from a browser. The site calls it from its
# own server, so this normally only matters for local tools. Never "*" in
# production — startup refuses it.
CORS_ORIGINS=http://localhost:3000

# Who may open /admin: a comma-separated list of PLAYER CODES — the
# six-character handle on the account page, e.g. K7M2QX. Not email addresses:
# nothing here sends mail, so an address proves nothing about who owns it.
# Empty denies everyone. To make yourself an operator: create an account on
# the site, copy its code from the Account tab, put it here, restart.
ADMIN_PLAYER_CODES=

PASSWORD_MIN_LENGTH=10

# Argon2id cost — OWASP's minimum profile. Each hash in flight holds this
# much memory, so size it to the container, and bound how many run at once.
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_PARALLELISM=1
PASSWORD_HASH_CONCURRENCY=2

# Sign-in attempts against one email address per window.
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SECONDS=900
# Sign-in attempts from one visitor per window, whatever the address.
AUTH_IP_RATE_MAX=30
AUTH_IP_RATE_WINDOW_SECONDS=900
# New accounts, registered or guest, one visitor may open per window.
SIGNUP_IP_RATE_MAX=10
SIGNUP_IP_RATE_WINDOW_SECONDS=3600

# Messages a player may send the operator per window. Protects the person who
# reads the inbox, not the database.
MESSAGE_RATE_MAX=5
MESSAGE_RATE_WINDOW_SECONDS=3600

# ----- Articles ----------------------------------------------------------
# Anyone with an account can write; nothing is public until an operator has
# read it. An operator's own articles publish when submitted.

# Unfinished articles one account may hold at a time.
ARTICLE_MAX_OPEN=20
# Different articles one account may submit for review per window (a day).
ARTICLE_SUBMIT_RATE_MAX=3
ARTICLE_SUBMIT_RATE_WINDOW_SECONDS=86400

# ----- Safer play --------------------------------------------------------

# A player can lower their daily limit at once. Raising or removing it waits
# this long after it was last set: 24 hours.
LIMIT_LOOSEN_DELAY_SECONDS=86400

# The lengths of break on offer, in hours: a day, three days, a week, a month.
# A break cannot be shortened or cancelled once started.
BREAK_OPTIONS_HOURS=24,72,168,720

# The bookmaker margin the reality check illustrates with, per pick. This
# product charges none; the page uses this figure, labelled as an
# illustration, to show what the same record would have cost somewhere that
# does. Must be between 0 and 0.5.
REFERENCE_MARGIN=0.05

# ----- The game ----------------------------------------------------------
# Points are stored in minor units: 100 = 1 point.

# Everybody starts with 1,000 points…
SIGNUP_BONUS_MINOR=100000
# …and can claim 200 a day, the same every day. No streaks.
DAILY_TOPUP_MINOR=20000

# The day boundary for the top-up, the daily limit and leaderboard seasons.
# An IANA zone name, e.g. Europe/London.
ECONOMY_TIMEZONE=UTC

MIN_STAKE_MINOR=1000
MAX_STAKE_MINOR=500000
PAYOUT_CAP_MINOR=10000000

# ----- The shop ----------------------------------------------------------
# Points can be bought through Stripe. The game stays free without it: this
# is how the site is paid for, since it carries no advertising.
#
# EMPTY MEANS CLOSED. With no key nothing is for sale and the site says so.
# Setting the key is the act of opening the shop. A live key (sk_live_… or a
# restricted rk_live_…) is required in production.
STRIPE_SECRET_KEY=
# The signing secret (whsec_…) of a Stripe webhook endpoint pointed at
#   https://<this API's public address>/v1/payments/stripe/webhook
# sending: checkout.session.completed, checkout.session.expired,
# charge.refunded, charge.dispute.created.
# Points are credited only by a message this secret verifies, so the API
# refuses to start with a key and no secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com
# The website's public https address — where Stripe returns people after
# checkout. Falls back to the first of CORS_ORIGINS.
SITE_URL=

SHOP_CURRENCY=usd
# What 1,000 points cost, in cents. One price per point at every pack size:
# there is no volume discount to configure.
SHOP_PRICE_PER_THOUSAND_CENTS=200
# The pack sizes on offer, in whole points.
SHOP_PACK_POINTS=1000,2500,5000
# The most one account may spend in a calendar month, in cents. Nobody can
# raise it for themselves; a player's own limit may only be lower. Must be
# positive — to stop selling, unset the key.
SHOP_MONTHLY_CAP_CENTS=2000
# How long a started checkout stays open (Stripe's minimum is 30). It counts
# towards the cap until it lapses.
SHOP_CHECKOUT_MINUTES=30
SHOP_MIN_AGE=18

# Picks on one slip, and the longest combined price a slip may carry.
MAX_LEGS=5
MAX_COMBINED_ODDS=1000

# A question is open to forecasts only while the market prices it inside this
# band. Outside it the question is refused, not priced at the edge — clamping
# would overpay near-certain outcomes.
MIN_PROB=0.01
MAX_PROB=0.99

# How far the combined odds may move against the player between the quote
# they saw and the forecast they sent before they are asked to confirm again.
ODDS_DRIFT_TOLERANCE=0.01

# Points a player must have staked on settled forecasts to be ranked, and the
# volume at which a record counts in full.
LEADERBOARD_MIN_VOLUME_MINOR=10000
LEADERBOARD_FULL_CREDIT_VOLUME_MINOR=500000

# ----- Market data workers -----------------------------------------------
# Off by default, so an API replica scales independently of ingestion. Run
# exactly one process with this on (make api-workers). If several do run, a
# lease in Postgres keeps one of them doing the work per tick.
WORKERS_ENABLED=false
RUN_DISCOVERY_ON_STARTUP=true
# Sync prices, settle and recount the standings once as the process starts,
# rather than waiting for each job's first tick. It is what makes a server
# that was asleep, or down, current again within seconds of waking.
CATCH_UP_ON_STARTUP=true

# Polymarket's public, read-only market data. No key, no account, no trades.
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

DISCOVERY_INTERVAL_MINUTES=60
DISCOVERY_CATEGORIES=Politics,Macro,Crypto
# Optional: build the feed around one topic. See config.py before using.
# DISCOVERY_PRIORITY_CATEGORY=
# DISCOVERY_PRIORITY_TAG_SLUGS=

PRICE_SYNC_INTERVAL_SECONDS=60
PRICE_SYNC_CONCURRENCY=50
PRICE_SYNC_MAX_MARKETS=400

# "midpoint" or "ask". The ask systematically underprices NO on a wide
# spread — see clients/clob.py before changing this.
PRICE_SOURCE=midpoint

PRICE_CACHE_TTL_SECONDS=300
# Older than this, a price is "updating" and the question cannot be picked.
PRICE_STALENESS_SECONDS=90

# Forecasting closes this long before the market's own end date.
MARKET_LOCK_BUFFER_SECONDS=300

# ----- What moved ---------------------------------------------------------
# A question is reported as having moved when its chance has changed by this
# much, as a probability: five points in a day, ten in a week.
MOVES_DAY_THRESHOLD=0.05
MOVES_WEEK_THRESHOLD=0.10
# Results are not moves. A question closing within this many hours is left
# out, and so is one within this margin of 0 or 100%, then or now.
MOVES_MIN_HOURS_TO_CLOSE=24
MOVES_DECIDED_MARGIN=0.03
# How old the source's change figures may be and still be shown. Older than
# this, the list of moves answers 503 until they have been read again.
MOVES_MAX_AGE_HOURS=6
# How old a price may be and still be called "now" in that list. Prices are
# read every minute; a server just woken has none this recent until its first
# pass, and says so (503) rather than report old prices as current.
MOVES_PRICE_MAX_AGE_SECONDS=600
# A question's page draws a week of hourly prices, fetched on request and
# kept this long. The fetch gives up quickly: the page is fine without it.
HISTORY_CACHE_SECONDS=600
HISTORY_TIMEOUT_SECONDS=3.0

RESOLUTION_INTERVAL_MINUTES=5
# Past this, a market the source has never settled is logged as a warning.
RESOLUTION_OVERDUE_HOURS=48
