ENVIRONMENT=development

# Postgres with db/migrations applied.
DATABASE_URL=postgresql://postgres@localhost:5432/appdb

# From @BotFather. The initData HMAC is derived from this, so it is the single
# most sensitive value in the system — it must never reach the frontend.
TELEGRAM_BOT_TOKEN=

# Signs session JWTs. Rotating it invalidates every live session.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=43200

# How stale Telegram's initData may be when exchanged for a session.
INIT_DATA_TTL_SECONDS=3600

# Opening balance in minor units (100000 = 1,000.00 coins).
SIGNUP_BONUS_MINOR=100000

CORS_ORIGINS=http://localhost:3000,https://web.telegram.org

# Telegram ids that may read /v1/admin/* (revenue, coin flow, conversion).
# Comma-separated. Empty denies everyone — it is never a way to open it up.
ADMIN_TELEGRAM_IDS=

# Fewest legs a slip may carry. 1 allows singles; 3 makes the app
# parlay-only and nearly triples the house edge, because the vig
# compounds per leg: 1 - (1 - vig)^n. See config.py for the full table.
MIN_LEGS=3

# The most the house will ever be DOWN on one market, in minor units.
# 20000000 = 200,000 toman = about one US dollar at TIER_1 pack pricing.
#
# This is what lets a player bet when nobody has taken the other side — with
# no users, that is every bet. It is checked net of the money staked against
# a side, so it is a floor of liquidity rather than a budget that depletes.
# Worst case across the whole book is this times the number of open markets.
HOUSE_SEED_MINOR=20000000

# Messages a player may send the operator per window. Protects the person who
# reads the inbox, not the database.
MESSAGE_RATE_WINDOW_SECONDS=3600
MESSAGE_RATE_MAX=5

REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# ----- Ingestion workers -----------------------------------------------
# Off by default: an API-only replica scales independently of ingestion.
# When several replicas do run workers, a Postgres advisory lock keeps
# exactly one of them doing the work per tick.
WORKERS_ENABLED=false
RUN_DISCOVERY_ON_STARTUP=true

GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

DISCOVERY_INTERVAL_MINUTES=60
DISCOVERY_CATEGORIES=Macro,Crypto

PRICE_SYNC_INTERVAL_SECONDS=60
PRICE_SYNC_CONCURRENCY=50

# "midpoint" or "ask". The ask systematically underprices NO and leaks more
# than the vig on a wide spread — see clients/clob.py before changing this.
PRICE_SOURCE=midpoint

PRICE_CACHE_TTL_SECONDS=300
PRICE_STALENESS_SECONDS=90

# Betting closes this long before the upstream end date.
MARKET_LOCK_BUFFER_SECONDS=300

# ----- Odds engine ------------------------------------------------------
VIG_RATE=0.05
MAX_LEGS=5

# Below this a "win" pays less than the stake. Above roughly
# p = (1 - VIG_RATE) / MIN_LEG_ODDS there is no price to offer.
MIN_LEG_ODDS=1.01
MAX_COMBINED_ODDS=1000000

MIN_STAKE_MINOR=1000
MAX_STAKE_MINOR=5000000
PAYOUT_CAP_MINOR=500000000

# Total open liability carried on one market and side.
MAX_MARKET_LIABILITY_MINOR=2000000000

# How far combined odds may drift against the player between the quote they
# saw and the placement they sent, before we ask them to re-confirm.
ODDS_DRIFT_TOLERANCE=0.01

# ----- Parlay insurance -------------------------------------------------
# Premium is (1 + load) x P(a covered near-miss), priced per slip from the
# actual legs. Cover is DECLINED when that exceeds the max rate — a ceiling
# that cuts the premium below its own payout probability loses money.
INSURANCE_LOAD=0.35
INSURANCE_MIN_RATE=0.05
INSURANCE_MAX_RATE=0.60
INSURANCE_MIN_LEGS=4
INSURANCE_COVERS_FAILED_LEGS=1

# ----- Telegram Stars ---------------------------------------------------
# Shared with Telegram when registering the webhook and returned by it in
# X-Telegram-Bot-Api-Secret-Token. Unset means the webhook refuses every
# delivery — an unconfigured secret must not mean an open coin-minting URL.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Point at a self-hosted Bot API server if you run one.
TELEGRAM_API_URL=https://api.telegram.org

INVOICE_TTL_SECONDS=3600
MAX_OPEN_INVOICES_PER_USER=5
INVOICE_SWEEP_INTERVAL_MINUTES=15

# Recovery for payments Telegram charged but whose webhook never arrived. Every
# sweep asks getStarTransactions what was actually charged and settles what we
# missed. The grace period keeps this from racing the ordinary webhook path;
# the window bounds how far back a dropped payment is still recoverable.
RECONCILIATION_GRACE_MINUTES=5
RECONCILIATION_WINDOW_HOURS=24
RECONCILIATION_BATCH_SIZE=200
# Telegram pages 100 at a time, newest first. The ceiling stops a sweep from
# walking the bot's entire history; paging also stops early once a page
# predates the oldest outstanding invoice.
RECONCILIATION_MAX_PAGES=10

# ----- Localisation -----------------------------------------------------
# Market text is translated on ingestion so no English reaches the client.
# "null" (default) passes text through unchanged — an unconfigured deployment
# ingests readable English rather than failing or shipping half-translated copy.
# "libretranslate" | "openai" | "null"
TRANSLATION_PROVIDER=null
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=gpt-4o-mini
TRANSLATION_SOURCE_LANG=en
TRANSLATION_TARGET_LANG=fa
TRANSLATION_BATCH_SIZE=8
# Kept small on purpose: a reasoning model spends ~594 reasoning tokens per
# sentence, so a batch of 50 is tens of thousands of tokens and reliably
# outruns even a generous timeout, failing every attempt and translating
# nothing. Smaller batches finish inside their timeout and get cached as
# they land, so raise this only alongside TRANSLATION_TIMEOUT_SECONDS.
# Requests in flight at once. Defaults to 1 because that is the strictest
# case: a provider account provisioned for exactly one concurrent request
# (Kimi's moonshot.ai account is) returns HTTP 429 on a second one before the
# first has had time to answer, and against a reasoning model that holds its
# slot for minutes, the few short retries in post_json run out long before it
# frees up. Raise this only for a provider actually provisioned for more.
TRANSLATION_CONCURRENCY=1

# ----- Resolution worker -----------------------------------------------
RESOLUTION_INTERVAL_MINUTES=5
RESOLUTION_CONCURRENCY=20
RESOLUTION_BATCH_SIZE=200
RESOLUTION_SETTLE_BATCH_SIZE=500
# Past this, a market upstream has never settled is logged as a warning.
RESOLUTION_OVERDUE_HOURS=48

# ----- Economy ----------------------------------------------------------
# The day boundary for drips, decay and seasons. Set this to the operator's
# own zone: a UTC boundary rolls the daily claim over mid-evening for anyone
# east of it, quietly cutting streaks.
ECONOMY_TIMEZONE=UTC

DAILY_DRIP_MINOR=25000
STREAK_BONUS_STEP_MINOR=5000
STREAK_BONUS_MAX_MINOR=50000

DECAY_RATE=0.05
DECAY_INACTIVE_DAYS=3
DECAY_FLOOR_MINOR=50000
# A player with an open slip is engaged; charging them punishes the behaviour
# the mechanic exists to encourage.
DECAY_SKIPS_OPEN_SLIPS=true

BOOST_GENERATION_INTERVAL_MINUTES=60
BOOSTS_PER_RUN=3
BOOST_MIN_MULTIPLIER=1.10
BOOST_MAX_MULTIPLIER=1.50
BOOST_DURATION_HOURS=4
BOOST_MAX_TOTAL_STAKE_MINOR=1000000
BOOST_MAX_STAKE_PER_USER_MINOR=100000
# Only a genuine longshot is boostable — above this the odds engine refuses
# to apply the boost anyway.
BOOST_MAX_RAW_PROB=0.10
BOOST_MIN_VOLUME_USD=10000

LEADERBOARD_MIN_VOLUME_MINOR=100000
LEADERBOARD_FULL_CREDIT_VOLUME_MINOR=2000000
LEADERBOARD_PROFIT_WEIGHT=1.0
LEADERBOARD_ROI_WEIGHT=0.5
