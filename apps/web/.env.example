# Copy to .env.local for development. Everything here is read on the server
# unless it starts with NEXT_PUBLIC_.

# Where the API lives. Server-side only, and deliberately not NEXT_PUBLIC_:
# the browser talks to this site's own /api routes and never learns the API's
# address or holds a credential for it.
API_BASE_URL=http://localhost:8000

# Shared secret with the API (its INTERNAL_API_KEY must be the same value).
# It is what lets the API accept sign-up, sign-in and guest sessions from this
# server and believe the visitor address it forwards for rate limiting.
# Leave empty in development when the API's is empty too. Required in
# production, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# Name of the HttpOnly cookie that holds the session.
SESSION_COOKIE_NAME=session

# The request header your hosting platform guarantees carries the visitor's
# address. Leave unset on Vercel, which overwrites x-real-ip and
# x-forwarded-for itself. Behind a proxy that passes a client's own value
# through, name the header it does control (cf-connecting-ip, fly-client-ip…)
# or the sign-up rate limit can be dodged by sending a made-up address.
# CLIENT_IP_HEADER=

# ----- shown on the site -------------------------------------------------
# Baked in at build time; change them and rebuild.

# The name in the header, the page titles and the copy.
# NEXT_PUBLIC_APP_NAME=NoGamper

# "Read the source" on the How it works page.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/Sinadehesh/nogamper

# Optional "Built by" credit on the How it works page. Shown only when a name
# is set; the URL makes it a link.
# NEXT_PUBLIC_AUTHOR_NAME=
# NEXT_PUBLIC_AUTHOR_URL=

# ----- being found -------------------------------------------------------

# The address people type, with no trailing slash. Every canonical link, the
# sitemap and the link-preview images are built from it, so it must be the one
# public address and not a preview URL. On Vercel it can be left unset: the
# project's production domain is used.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Proof of ownership for Google Search Console and Bing Webmaster Tools, which
# is where "is this page indexed, and for which searches" gets answered. Each
# console gives you a string to paste here; unset, no tag is written.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
